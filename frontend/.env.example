# ---------------------------------------------------------------------------
# Social Yolo — Frontend (Next.js) Environment Configuration Template
# Copy to .env.local and fill in your values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# App Origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters

# Provider-Agnostic PostgreSQL Connection
# Used by Better Auth to read/write user, session, and account tables directly.
# Compatible with local PostgreSQL, Supabase Pooler, Neon, Railway, RDS, etc.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/social_yolo

# Google OAuth Credentials (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cache & Rate Limiting (Provider-Agnostic Redis)
REDIS_URL=redis://localhost:6379

# Optional: Upstash Redis REST fallback (serverless-compatible, fail-open)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Backend NestJS Integration
BACKEND_PORT=3002
BACKEND_ORIGIN=http://localhost:3002

# Dynamic Branding Configuration
# Remote URL from which SocialYolo retrieves brand details (JSON)
# Supports template pattern: https://cdn.example.com/brands/{hostname}.json
NEXT_PUBLIC_BRAND_CONFIG_URL=
# Server-side equivalent
BRAND_CONFIG_URL=
# Optional: multi-domain JSON mapping (e.g. {"app.brand-a.com":"https://cdn.example.com/brand-a.json"})
NEXT_PUBLIC_BRAND_CONFIG_MAP=

# SafePay Public Key (optional client-side reference)
NEXT_PUBLIC_SAFEPAY_API_KEY=sec_sandbox_example_key
NEXT_PUBLIC_SAFEPAY_ENVIRONMENT=sandbox
