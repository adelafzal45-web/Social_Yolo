# Backend Configuration Template (Copy to Backend/.env)
# Provider-Agnostic PostgreSQL & Redis Architecture

PORT=3002
AUTH_REQUIRED=true

# --- Database (Provider-Agnostic PostgreSQL) --------------------------------
# Accepts any valid PostgreSQL connection string: Local Postgres, Supabase pooler,
# Neon, Railway, AWS RDS, GCP Cloud SQL, Render, Docker, etc.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/social_yolo

# Optional granular database overrides (used if DATABASE_URL is not set):
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=social_yolo
DATABASE_SYNCHRONIZE=false

# --- Cache & Rate Limiting (Provider-Agnostic Redis) ------------------------
# Standard Redis connection string: redis://:password@host:port or rediss://...
REDIS_URL=redis://localhost:6379

# Optional: Upstash Redis REST fallback (serverless-compatible, fail-open)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Rate limiting tunables (defaults shown)
AUTH_RATELIMIT_MAX=10
AUTH_RATELIMIT_WINDOW=60
PROFILE_CACHE_TTL_SECONDS=60

# --- JWT & Better Auth Integration ------------------------------------------
# Secret key used for signing session tokens and legacy HS256 tokens
JWT_SECRET=your_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d
DEFAULT_ORGANIZATION_ID=

BG_REMOVAL_PROVIDER=imgly
# small/medium use bundled offline assets. large requires the HTTPS setting below.
IMGLY_MODEL=medium
# HTTPS directory ending in /, with resources.json mapping /models/large and model chunks.
# IMGLY_LARGE_PUBLIC_PATH=https://your-model-host.example/assets/

# Optional BRIA integration. Both values are required to make BRIA available.
BRIA_API_URL=
# SECRET. Rotate only if the key has been shared outside this machine.
BRIA_API_KEY=
BG_FALLBACK_ENABLED=true

# Set all three ENABLED switches (refine, analysis, fallback) false for legacy byte parity.
BG_REFINE_ENABLED=true
BG_ANALYSIS_ENABLED=true
BG_REFINE_SOLID_THRESH=230
BG_REFINE_DECONTAM_DECAY=0.9
BG_REFINE_DECONTAM_MAX_RADIUS=32
BG_REFINE_BLACK_LO=8
# Keep BLACK_HI <= 40 to protect fine hair.
BG_REFINE_BLACK_HI=32
BG_REFINE_WHITE_LO=232
BG_REFINE_WHITE_HI=252
BG_REFINE_FEATHER_ENABLED=false
# Fixed v1 three-tap kernel; only 0.6 is supported.
BG_REFINE_FEATHER_SIGMA=0.6
# Reserved; has no effect in v1 (inline processing).
BG_REFINE_IN_WORKER=false

BG_QA_MIN_COVERAGE=0.005
BG_QA_HAZE_FRAC=0.15
BG_QA_MIN_MAX_ALPHA=32
BG_QA_MIN_TRANSPARENT_FRAC=0.01
BG_QA_MAX_MIN_ALPHA=250
BG_QA_MAX_BORDER_OPAQUE_FRAC=0.4
BG_QA_MIN_OPAQUE_FRAC=0.02
BG_QA_MAX_TRANSITION_BAND_FRAC=0.6

MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_TOTAL_PIXELS=16777216
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_SIZE=10
PROCESSING_TIMEOUT_MS=60000
OUTPUT_QUALITY=90
# Legacy settings retained for compatibility; processing creates no files here.
STORAGE_DIR=storage/processed
TEMP_DIR=storage/temp

# --- Website Analyzer & Brand Intelligence Pipeline -------------------------
WEBSITE_ANALYZER_TIMEOUT_MS=15000
WEBSITE_ANALYZER_MAX_RESPONSE_BYTES=5000000
WEBSITE_ANALYZER_MAX_TEXT_LENGTH=30000
WEBSITE_ANALYZER_MAX_HEADINGS=50
WEBSITE_ANALYZER_MAX_IMAGES=50
WEBSITE_ANALYZER_MAX_INTERNAL_PAGES=5
WEBSITE_ANALYZER_BROWSER_FALLBACK=true
WEBSITE_ANALYZER_CACHE_TTL_SECONDS=3600
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_API_KEY=your_gemini_api_key

# --- SafePay Payment Gateway Integration ------------------------------------
# Environment: sandbox | production
SAFEPAY_ENVIRONMENT=sandbox
# SafePay Public/API Key
SAFEPAY_API_KEY=sec_sandbox_example_key
# SafePay Secret Key (used to generate passport tokens and verify orders)
SAFEPAY_SECRET_KEY=sandbox_secret_key_example
# SafePay Webhook HMAC-SHA256 Signing Secret
SAFEPAY_WEBHOOK_SECRET=sandbox_webhook_secret_example
# Default settlement currency (PKR or USD)
SAFEPAY_CURRENCY=PKR
